{
  "schemaVersion": 1,
  "rules": [
    "Check the licence on the source page at download time and let scripts/asset_fetch.py record it in the ledger. Only CC0, CC BY and (fonts) SIL OFL are allowed.",
    "Never download models of the licensed characters (Farhat, Tilda, Wings, Ben, the Shadow, Egokhan, Rashid and the rest). They are modelled from the rights holder's model sheets. Until then use the stand-in humanoid and creature rigs below.",
    "Prefer stylised, low to mid poly assets that match the bible's art direction: flat or lightly toon-shaded URP materials, shared texture atlases.",
    "Keep to the performance budgets in references/project/10-performance-and-platform-targets.md. Reject assets over the per-chapter budget instead of importing them.",
    "Keep every download under Assets/ThirdParty/<source>/ so the ledger paths stay stable."
  ],
  "sources": {
    "polyhaven": {
      "site": "https://polyhaven.com",
      "license": "cc0",
      "kinds": [
        "hdris",
        "textures",
        "models"
      ],
      "how": "python3 scripts/asset_fetch.py polyhaven search|download"
    },
    "kenney": {
      "site": "https://kenney.nl/assets",
      "license": "cc0 (confirm on the pack page)",
      "kinds": [
        "models",
        "ui",
        "audio",
        "textures"
      ],
      "how": "find the pack page, then python3 scripts/asset_fetch.py url download --license cc0 ..."
    },
    "quaternius": {
      "site": "https://quaternius.com",
      "license": "cc0 (confirm on the pack page)",
      "kinds": [
        "models",
        "characters",
        "animations"
      ],
      "how": "find the pack page, then python3 scripts/asset_fetch.py url download --license cc0 ..."
    },
    "sketchfab": {
      "site": "https://sketchfab.com",
      "license": "per model; only CC0 and CC BY accepted",
      "kinds": [
        "models"
      ],
      "how": "python3 scripts/asset_fetch.py sketchfab search|download (needs SKETCHFAB_API_TOKEN)"
    },
    "opengameart": {
      "site": "https://opengameart.org",
      "license": "per asset; only CC0 and CC BY accepted",
      "kinds": [
        "audio",
        "music",
        "2d"
      ],
      "how": "python3 scripts/asset_fetch.py url download with the licence shown on the asset page"
    },
    "freesound": {
      "site": "https://freesound.org",
      "license": "per sound; only CC0 and CC BY accepted",
      "kinds": [
        "audio"
      ],
      "how": "python3 scripts/asset_fetch.py url download with the licence shown on the sound page"
    },
    "google-fonts": {
      "site": "https://fonts.google.com",
      "license": "SIL OFL 1.1 for most families (confirm per family)",
      "kinds": [
        "fonts"
      ],
      "how": "python3 scripts/asset_fetch.py url download --license OFL ..."
    }
  },
